# ====================================================================
# Antigravity Mobile - Git Ignore 配置
# 追踪 Android 与 Go 网关源码，忽略本地构建与研究资料
# ====================================================================

# 1. 仅放行应用与网关源码
/*
!/.gitignore
!/Agent.md
!/android/
!/cmd/
!/internal/
!/web/
!/go.mod
!/go.sum
!/Makefile
!/env.example
!/.gitattributes

# 2. Android 编译中间件与构建产物
.gradle/
android/.gradle/
android/**/build/
android/**/.cxx/
android/local.properties
*.apk
*.aab
*.hprof
android/*.zip

# 3. Android Studio / IntelliJ IDEA 配置
.idea/
android/.idea/
*.iml
android/**/*.iml
android/.navigation/
android/captures/

# 4. Gradle Wrapper 临时属性
android/gradle/gradle-daemon-jvm.properties

# 5. 系统与编辑器临时文件
.DS_Store
Thumbs.db
ehthumbs.db
tmp/
temp/
*.tmp
*.swp
*.bak
